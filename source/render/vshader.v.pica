; Inizializzazione delle costanti di base
.constf myconst(0.0, 1.0, -1.0, 0.5)
.alias  zeros myconst.xxxx
.alias  ones  myconst.yyyy

; --- VARIABILI UNIFORM (Inviate dal main.c) ---
.fvec projection[4]
.fvec modelView[4]
.fvec uvoff

; --- OUTPUT (Dati inviati allo schermo) ---
.out outpos position
.out outtc0 texcoord0
.out outclr color

; --- INPUT (Dati letti dal VBO) ---
; v0 = Posizione (X, Y, Z)
; v1 = Coordinate Texture (U, V)
; v2 = Colore (R, G, B)
.alias inpos v0
.alias intex v1
.alias inclr v2

.proc main
    ; 1. Moltiplichiamo la Posizione per la Matrice di Vista (La Telecamera)
    ; r1 = modelView * inpos
    dp4 r1.x, modelView[0], inpos
    dp4 r1.y, modelView[1], inpos
    dp4 r1.z, modelView[2], inpos
    dp4 r1.w, modelView[3], inpos

    ; 2. Moltiplichiamo il risultato per la Matrice di Proiezione (Il 3D / Prospettiva)
    ; outpos = projection * r1
    dp4 outpos.x, projection[0], r1
    dp4 outpos.y, projection[1], r1
    dp4 outpos.z, projection[2], r1
    dp4 outpos.w, projection[3], r1

  ; 3. Calcoliamo l'offset UV della texture (utile per le animazioni future)
    ; outtc0 = intex + uvoff
    mov r0, uvoff
    add outtc0, intex, r0

    ; 4. Passiamo il colore intatto
    ; outclr = inclr
    mov outclr, inclr

    ; Fine del programma GPU
    end
.end